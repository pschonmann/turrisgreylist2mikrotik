:local expectedCount 35
:local newCount [:len [/ipv6 firewall address-list find where list="turris_greylist_new"]]
:if ($newCount != $expectedCount) do={
    :log error ("Turris Greylist ipv6 incomplete: " . $newCount . "/" . $expectedCount)
    :error "Turris Greylist ipv6 import incomplete"
}
/ipv6 firewall address-list remove [/ipv6 firewall address-list find where list="turris_greylist"]
:foreach item in=[/ipv6 firewall address-list find where list="turris_greylist_new"] do={
    /ipv6 firewall address-list set $item list="turris_greylist"
}
:log info "Turris Greylist ipv6 updated"
